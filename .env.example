NODE_ENV=production
PORT=3000

MONGODB_URI=mongodb://localhost:27017/novatalk

SESSION_EXPIRY=86400
IDENTITY_RETENTION=2592000
MESSAGE_RETENTION=2592000

FILE_TRANSFER_LIMIT=52428800

STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=
TURN_USERNAME=
TURN_PASSWORD=

NSFW_BLOCK_THRESHOLD=0.85
NSFW_REVIEW_THRESHOLD=0.65
NSFW_WARNING_LIMIT=1
NSFW_TEMP_BAN_LIMIT=2
NSFW_PERMANENT_BAN_LIMIT=3
NSFW_REVIEW_ESCALATION=3
TEMP_BAN_DURATION=86400
LONG_BAN_DURATION=2592000
IP_BAN_MAX_DURATION=86400

REPORT_RESTRICT_THRESHOLD=5

ALLOWED_ORIGINS=https://novatalk.example.com,https://app.example.com

SESSION_SECRET=
IP_HASH_SECRET=
ADMIN_SECRET=

TRUST_PROXY=0
MAX_CIPHERTEXT_LENGTH=32768
MAX_GROUP_MEMBERS=100
MAX_ROOM_MEMBERS=100
ROOM_MAX_LIFETIME=86400
ROOMS_PER_IDENTITY=3
MATCH_QUEUE_TIMEOUT=120
MAX_QUEUE_SIZE=10000
MAX_SOCKETS_PER_IDENTITY=5
